<?xml version="1.0" encoding="utf-8"?>
<StartupServicesManifest xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://schemas.microsoft.com/2011/01/fabric">
  <Parameters>
    <Parameter Name="EventDispatcherService_MinReplicaSetSize" DefaultValue="1" />
    <Parameter Name="EventDispatcherService_PartitionCount" DefaultValue="1" />
    <Parameter Name="EventDispatcherService_TargetReplicaSetSize" DefaultValue="1" />
    <Parameter Name="BankService_MinReplicaSetSize" DefaultValue="1" />
    <Parameter Name="BankService_PartitionCount" DefaultValue="1" />
    <Parameter Name="BankService_TargetReplicaSetSize" DefaultValue="1" />
    <Parameter Name="LibraryService_MinReplicaSetSize" DefaultValue="1" />
    <Parameter Name="LibraryService_PartitionCount" DefaultValue="1" />
    <Parameter Name="LibraryService_TargetReplicaSetSize" DefaultValue="1" />
    <Parameter Name="Validator_InstanceCount" DefaultValue="1" />
    <Parameter Name="BackendSF_InstanceCount" DefaultValue="1" />
  </Parameters>
  <Services>
    <Service Name="EventDispatcherService" ServicePackageActivationMode="ExclusiveProcess">
      <StatefulService ServiceTypeName="EventDispatcherServiceType" TargetReplicaSetSize="[EventDispatcherService_TargetReplicaSetSize]" MinReplicaSetSize="[EventDispatcherService_MinReplicaSetSize]">
        <SingletonPartition />
      </StatefulService>
    </Service>
    <Service Name="BankService" ServicePackageActivationMode="ExclusiveProcess">
      <StatefulService ServiceTypeName="BankServiceType" TargetReplicaSetSize="[BankService_TargetReplicaSetSize]" MinReplicaSetSize="[BankService_MinReplicaSetSize]">
        <SingletonPartition />
      </StatefulService>
    </Service>
    <Service Name="LibraryService" ServicePackageActivationMode="ExclusiveProcess">
      <StatefulService ServiceTypeName="LibraryServiceType" TargetReplicaSetSize="[LibraryService_TargetReplicaSetSize]" MinReplicaSetSize="[LibraryService_MinReplicaSetSize]">
        <SingletonPartition />
      </StatefulService>
    </Service>
    <Service Name="Validator" ServicePackageActivationMode="ExclusiveProcess">
      <StatelessService ServiceTypeName="ValidatorType" InstanceCount="[Validator_InstanceCount]">
        <SingletonPartition />
      </StatelessService>
    </Service>
    <Service Name="BackendSF" ServicePackageActivationMode="ExclusiveProcess">
      <StatelessService ServiceTypeName="BackendSFType" InstanceCount="[BackendSF_InstanceCount]">
        <SingletonPartition />
      </StatelessService>
    </Service>
  </Services>
</StartupServicesManifest>